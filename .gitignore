# NF-RNAseq initial release exclusions

###############################################################################
# Generated reference databases and local installations
###############################################################################

/db/*
/GRCh38/
/config/main.config

###############################################################################
# Development data, analysis outputs, and archived code
###############################################################################

/results/
/test_data/
/logs/
/archive/
/inputs/
/data/

###############################################################################
# Future Nextflow modules and bundled third-party development resources
#
# The current shell installer/runtime requires only the QC validator.
###############################################################################

/modules/*
!/modules/qc/
/modules/qc/*
!/modules/qc/qc_validator.py
!/modules/fusion/
!/modules/fusion/**
!/modules/isoforms/
!/modules/isoforms/**
!/modules/dge/
!/modules/dge/**
!/modules/gsea/
!/modules/gsea/**
!/modules/go/
!/modules/go/**
!/modules/decoupler/
!/modules/decoupler/**
!/modules/hytesum/
!/modules/hytesum/**
!/modules/sarsig/
!/modules/sarsig/**
!/modules/ssgsva/
!/modules/ssgsva/**

###############################################################################
# Nextflow runtime and future-development artifacts
###############################################################################

/work/
/.nextflow/
/.nextflow.log*
/trace.txt
/timeline.html
/report.html
/dag.html

###############################################################################
# Local R and renv state
###############################################################################

.Rhistory
.Rapp.history
.RData
.RDataTmp
.Ruserdata
.Renviron
.Rproj.user/

/renv/library/
/renv/local/
/renv/staging/
/renv/cellar/
/renv/cache/

# Developer-only renv initialization/project files. Releases restore from
# renv.lock via setup/scripts/restore_renv.R.
/setup/scripts/initialize_renv.R
/setup/scripts/scripts.Rproj

###############################################################################
# Sequencing data and generated bioinformatics files
###############################################################################

*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bai
*.cram
*.crai

###############################################################################
# Build products, backups, logs, and temporary files
###############################################################################

*.o
*.a
*.so
*.bak
*.tmp
*.log
*.out
*.err
*~

*.Rcheck/
*-Ex.R
*_cache/
/cache/
*.utf8.md
*.knit.md

.httr-oauth
.DS_Store
