# Bulk Illumina RNA-seq QC thresholds
# Generated reports use these values; adjust them to suit a specific study.

# Sequencing QC: minimum values
MIN_TOTAL_READS_PASS=20000000
MIN_TOTAL_READS_WARNING=10000000
MIN_Q30_PASS=90
MIN_Q30_WARNING=80
MIN_TRIM_RETENTION_PASS=85
MIN_TRIM_RETENTION_WARNING=70

# Sequencing QC: maximum values
MAX_ADAPTER_CONTAMINATION_PASS=10
MAX_ADAPTER_CONTAMINATION_WARNING=25
MAX_N_BASES_PASS=0.1
MAX_N_BASES_WARNING=1

# SILVA rRNA depletion: percentage of trimmed fragments removed. This metric
# is only evaluated when rRNA filtering is enabled for the core run.
MAX_RRNA_RATE_PASS=10
MAX_RRNA_RATE_WARNING=25

# STAR alignment QC: minimum values
MIN_UNIQUE_MAPPING_PASS=80
MIN_UNIQUE_MAPPING_WARNING=60

# STAR alignment QC: maximum values
MAX_MULTI_MAPPING_PASS=15
MAX_MULTI_MAPPING_WARNING=30
MAX_UNMAPPED_PASS=20
MAX_UNMAPPED_WARNING=40
MAX_MISMATCH_RATE_PASS=2
MAX_MISMATCH_RATE_WARNING=5
MAX_CHIMERIC_RATE_PASS=5
MAX_CHIMERIC_RATE_WARNING=10

# RSEM expression QC: minimum values
MIN_GENES_TPM_PASS=10000
MIN_GENES_TPM_WARNING=5000
MIN_GENES_COUNT_PASS=12000
MIN_GENES_COUNT_WARNING=6000
MIN_EXPECTED_COUNTS_PASS=15000000
MIN_EXPECTED_COUNTS_WARNING=5000000

# Overall classification
MAX_WARNINGS_FOR_PASS=2
FAIL_METRICS_FOR_OVERALL_FAIL=2

# A failure in any of these metrics immediately fails the sample.
IMMEDIATE_FAIL_METRICS=total_reads,trim_retention,unique_mapping,genes_tpm_gt_1
