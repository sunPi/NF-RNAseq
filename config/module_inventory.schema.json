{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sunPi/NF-RNAseq/config/module_inventory.schema.json",
  "title": "NF-RNAseq module inventory",
  "description": "Schema for current and planned NF-RNAseq biological analysis modules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "modules"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/module"
      }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "requires_design",
        "requires_contrast"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "requires_design": {
          "type": "boolean"
        },
        "requires_contrast": {
          "type": "boolean"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "execution_scope",
        "status",
        "summary",
        "requires_design",
        "requires_contrast",
        "inputs",
        "outputs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "category": {
          "enum": [
            "matrix",
            "fastq_bam"
          ]
        },
        "execution_scope": {
          "enum": [
            "sample",
            "cohort",
            "hybrid"
          ]
        },
        "status": {
          "enum": [
            "planned",
            "in_development",
            "implemented",
            "deprecated"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "requires_design": {
          "type": "boolean"
        },
        "requires_contrast": {
          "type": "boolean"
        },
        "supports_layout": {
          "type": "array",
          "items": {
            "enum": [
              "single",
              "paired",
              "not_applicable"
            ]
          },
          "uniqueItems": true
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "uniqueItems": true
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "modes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mode"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
